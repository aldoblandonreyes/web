          "_name": "afeatures12",
          "_sourceTheme": "homem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features12 homem5\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\" plugins=\"mobirise-icons2\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"range\" inline title=\"Item Count\" name=\"itemCount\" min=\"1\" max=\"4\" step=\"1\" value=\"2\">\n        <input type=\"checkbox\" title=\"Number\" name=\"showNumber\" checked>\n        <input type=\"color\" title=\"Number Bg\" name=\"numberBg\" value=\"#1a1e21\" condition=\"showNumber\">\n        <input type=\"checkbox\" title=\"Item Text\" name=\"showItemText\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1.jpg\" selected>\n            <input type=\"color\" title=\"Color\" value=\"#1a1e21\">\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#1a1e21\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-text\" mbr-if=\"showTitle || showText || showButtons\">\n                <div class=\"card-wrap\">\n                    <h6 class=\"card-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">Expert Painting Services for Homes &amp; Businesses!</h6>\n                    <p class=\"mbr-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">\n                        🎨 We bring expertise, precision, and high-quality materials to every project. Whether it's your home or business, our professional painting services ensure a flawless finish that enhances your space. Trust A&amp;F New Era Painting LLC to deliver vibrant colors and lasting results! \n                    </p>\n                    <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n                        <a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Learn More</a>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-item\">\n                <div class=\"item-wrap\">\n                    <div class=\"number-wrap\" mbr-if=\"showNumber\">\n                        <p class=\"number-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\" data-app-selector=\".number-text\">\n                           99%\n                        </p>\n                    </div>\n                    <p class=\"item-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\" data-app-selector=\".item-text\" mbr-if=\"showItemText\">Positive Feedback<br></p>\n                </div>\n\n                <div class=\"item-wrap\" mbr-if=\"itemCount > 1\">\n                    <div class=\"number-wrap\" mbr-if=\"showNumber\">\n                        <p class=\"number-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\" data-app-selector=\".number-text\">16+</p>\n                    </div>\n                    <p class=\"item-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\" data-app-selector=\".item-text\" mbr-if=\"showItemText\">\n                        Years of Experience\n                    </p>\n                </div>\n                <div class=\"item-wrap\" mbr-if=\"itemCount > 2\">\n                    <div class=\"number-wrap\" mbr-if=\"showNumber\">\n                        <p class=\"number-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\" data-app-selector=\".number-text\">\n                            76%\n                        </p>\n                    </div>\n                    <p class=\"item-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\" mbr-if=\"showItemText\">\n                        feugiat\n                    </p>\n                </div>\n                <div class=\"item-wrap\" mbr-if=\"itemCount > 3\">\n                    <div class=\"number-wrap\" mbr-if=\"showNumber\">\n                        <p class=\"number-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\" data-app-selector=\".number-text\">\n                            43%\n                        </p>\n                    </div>\n                    <p class=\"item-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\" mbr-if=\"showItemText\">\n                        ultricies\n                    </p>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uFLVjRjOvj",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "afeatures12-7"
