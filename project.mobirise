        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            ".mbr-section-head": {
              "margin-bottom": "50px"
            },
            ".mbr-section-title": {
              "color": "#e3ebf3"
            },
            ".mbr-section-subtitle": {
              "margin-top": "20px",
              "color": "#e3ebf3"
            },
            ".row": {
              "display": "flex",
              "align-items": "stretch",
              "gap": "20px",
              "@media (max-width: 767px)": {
                "gap": "12px"
              }
            },
            ".item-wrap": {
              "position": "relative",
              "display": "flex",
              "flex-direction": "column",
              "justify-content": "space-between",
              "height": "100%",
              "padding": "50px",
              "@media (max-width: 1399px)": {
                "padding": "30px"
              },
              "@media (max-width: 991px)": {
                "padding": "20px"
              },
              "@media (max-width: 767px)": {
                "padding": "12px"
              }
            },
            ".item-title": {
              "position": "relative",
              "width": "100%",
              "color": "#e3ebf3"
            },
            ".mbr-section-btn": {
              "position": "relative",
              "width": "100%",
              "transform": "translateX(50%)",
              "opacity": "0",
              "transition": ".5s",
              ".btn": {
                "min-width": "200px !important",
                "min-height": "auto",
                "aspect-ratio": "(1 / 1)",
                "padding": "20px !important",
                "border-radius": "50% !important",
                "@media (max-width: 1399px)": {
                  "min-width": "150px !important",
                  "padding": "15px !important"
                },
                "@media (max-width: 767px)": {
                  "min-width": "100px !important",
                  "padding": "10px !important"
                }
              },
              ".btn-black": {
                "&:hover": {
                  "background-color": "@primaryColor !important",
                  "border-color": "@primaryColor !important"
                }
              }
            },
            ".mbr-text": {
              "position": "relative",
              "width": "50%",
              "color": "#e3ebf3",
              "transform": "translateX(100%)",
              "opacity": "0",
              "transition": ".5s",
              "@media (max-width: 1399px)": {
                "width": "100%",
                "transform": "translateX(50%)"
              }
            },
            ".item": {
              "width": "1px",
              "flex-grow": "1",
              "min-height": "~\"calc(@{imageHeight} * 200px)\"",
              "padding": "0 !important",
              "background-position": "center center",
              "background-size": "cover",
              "background-repeat": "no-repeat",
              "@media (max-width: 1399px)": {
                "min-height": "~\"calc(@{imageHeight} * 150px)\""
              },
              "@media (max-width: 991px)": {
                "width": "100%"
              },
              "@media (max-width: 767px)": {
                "min-height": "~\"calc(@{imageHeight} * 80px)\""
              },
              "&:before": {
                "content": "\"\"",
                "position": "absolute",
                "top": "0",
                "left": "0",
                "width": "100%",
                "height": "100%",
                "background": "@itemBgOverlay",
                "opacity": "@itemBgOpacity",
                "transition": ".5s"
              },
              "&:nth-child(1)": {
                "background-image": "url(@item1Bg)",
                ".item-wrap": {
                  "flex-direction": "column-reverse"
                },
                ".mbr-section-btn": {
                  "transform": "translateX(0) scale(0)",
                  "transition": ".8s"
                },
                ".mbr-text": {
                  "transform": "translateX(0)",
                  "transition": ".8s"
                },
                "&:hover": {
                  "&:before": {
                    "opacity": "0.55"
                  },
                  ".mbr-section-btn": {
                    "transform": "translateX(0) scale(1)",
                    "opacity": "1"
                  },
                  ".mbr-text": {
                    "opacity": "1"
                  }
                }
              },
              "&:nth-child(2)": {
                "background-image": "url(@item2Bg)",
                "&:hover": {
                  "&:before": {
                    "opacity": "0.55"
                  },
                  ".mbr-section-btn": {
                    "transform": "translateX(0)",
                    "opacity": "1"
                  },
                  ".mbr-text": {
                    "transform": "translateX(0)",
                    "opacity": "1"
                  }
                }
              }
            }
          },
          "_name": "afeatures2",
          "_sourceTheme": "homem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features2 homem5\" group=\"Features\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" name=\"showTitle\" title=\"Title\">\n        <input type=\"checkbox\" name=\"showSubtitle\" title=\"Subtitle\">\n        <header>Cards</header>\n        <select title=\"Count\" name=\"cardsCount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\" selected>2</option>\n        </select>\n        <input type=\"range\" name=\"imageHeight\" title=\"Height\" min=\"1\" max=\"6\" step=\"1\" value=\"4\">\n        <input type=\"checkbox\" name=\"showCardTitle\" title=\"Title\" checked>\n        <input type=\"checkbox\" name=\"showText\" title=\"Text\" checked>\n        <input type=\"checkbox\" name=\"showButtons\" title=\"Buttons\" checked>\n        <input type=\"image\" title=\"Item 1 Bg\" name=\"item1Bg\" value=\"@PROJECT_PATH@/assets/images/pexels-expect-best-323781.jpg\">\n        <input type=\"image\" title=\"Item 2 Bg\" name=\"item2Bg\" value=\"@PROJECT_PATH@/assets/images/pexels-pixabay-280222.jpg\" condition=\"cardsCount > 1\">\n        <input type=\"color\" title=\"Item Overlay\" name=\"itemBgOverlay\" value=\"#000000\">\n        <input type=\"range\" inline title=\"Item Overlay Opacity\" name=\"itemBgOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.2\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" required>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1.jpg\" selected>\n            <input type=\"color\" title=\"Color\" value=\"#1a1e21\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#1a1e21\" condition=\"overlay && bg.type == 'image'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay && bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"mbr-section-head\" mbr-if=\"showTitle || showSubtitle\">\n            <h4 class=\"mbr-section-title mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">\n                Vitae proin\n            </h4>\n            <h5 class=\"mbr-section-subtitle mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">\n                Quisque non tellus orci ac auctor augue mauris\n            </h5>\n        </div>\n\n        <div class=\"row\">\n\n            <div class=\"item border-item\">\n                <div class=\"item-wrap\">\n                    <h5 class=\"item-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-2\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">Elegance</h5>\n                    <div class=\"mbr-section-btn item-footer align-center mt-auto mb-auto\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-7\"><a class=\"btn btn-black item-btn\" target=\"_blank\" data-app-placeholder=\"Type Text\" href=\"#\">\n                            LEARN<br> MORE\n                        </a></div>\n                    <p class=\"mbr-text mbr-fonts-style mt-1\" mbr-if=\"showText\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-text\">\n                        is the harmony of style, sophistication, and simplicity—effortless, refined, and timeless.\n                    </p>\n                </div>\n            </div>\n\n            <div class=\"item border-item\" mbr-if=\"cardsCount > 1\">\n                <div class=\"item-wrap\">\n                    <h5 class=\"item-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-2\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">A Fresh Touch of Serenity</h5>\n                    <div class=\"mbr-section-btn item-footer align-center mt-auto mb-auto\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-7\"><a class=\"btn btn-black item-btn\" target=\"_blank\" data-app-placeholder=\"Type Text\" href=\"#\">\n                            LEARN<br> MORE\n                        </a></div>\n                    <p class=\"mbr-text mbr-fonts-style mt-1\" mbr-if=\"showText\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-text\">Transform your home with soft, serene colors that bring harmony and beauty to your space.</p>\n                </div>\n            </div>\n\n        </div>\n    </div>\n</section>",
