              "gap": "20px",
              "padding": "32px",
              "& when (@showBorder)": {
                "border": "1px solid @borderColor",
                "border-radius": "20px"
              },
              "& when (@reverseContent)": {
                "flex-direction": "row-reverse"
              },
              "@media (max-width: 1399px)": {
                "padding": "20px"
              },
              "@media (max-width: 1199px)": {
                "& when (@showBorder)": {
                  "border-radius": "12px"
                }
              },
              "@media (max-width: 767px)": {
                "gap": "40px",
                "flex-wrap": "wrap",
                "padding": "12px",
                "& when (@showBorder)": {
                  "border-radius": "12px"
                }
              },
              "@media (min-width: 992px)": {
                "&:hover": {
                  ".image-wrapper": {
                    "img": {
                      "transform": "scale(1.1)"
                    }
                  }
                }
              }
            },
            ".col-text": {
              "display": "flex",
              "align-items": "flex-start",
              "width": "~\"calc(50% - 10px)\"",
              "@media (max-width: 1199px)": {
                "width": "100%",
                "order": "1"
              },
              "@media (max-width: 767px)": {
                "width": "100%"
              }
            },
            ".date-wrap": {
