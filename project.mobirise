      "settings": {
        "main": true,
        "title": "Home |  A&F NEW ERA PAINTING LLC",
        "meta_descr": "A&F New Era Painting LLC ofrece servicios profesionales de pintura interior y exterior para hogares y negocios. Nos especializamos en acabados de alta calidad, colores vibrantes y duraderos, y un trabajo detallado que transforma tus espacios. Con nuestro equipo de expertos, garantizamos resultados que reflejan tu estilo y visión, proporcionando un servicio confiable y eficiente. ¡Haz que tu hogar o negocio luzca increíble con A&F New Era Painting LLC!",
        "header_custom": "",
        "footer_custom": "",
        "html_before": "",
        "socialSharingUrl": ""
      },
      "components": [
        {
