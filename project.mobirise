        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".row": {
              "gap": "20px",
              "margin": "0 !important"
            },
            ".item": {
              "width": "~\"calc(50% - 10px)\"",
              "border-radius": "0",
              "padding": "0",
              "@media (max-width: 1199px)": {
                "width": "100%"
              }
            },
            ".item-wrapper": {
              "display": "flex",
              "align-items": "flex-start",
              "gap": "20px",
              "padding": "32px",
              "& when (@showBorder)": {
                "border": "1px solid @borderColor",
                "border-radius": "20px"
              },
              "& when (@reverseContent)": {
                "flex-direction": "row-reverse"
              },
              "@media (max-width: 1399px)": {
                "padding": "20px"
              },
              "@media (max-width: 1199px)": {
                "& when (@showBorder)": {
                  "border-radius": "12px"
                }
              },
              "@media (max-width: 767px)": {
                "gap": "40px",
                "flex-wrap": "wrap",
                "padding": "12px",
                "& when (@showBorder)": {
                  "border-radius": "12px"
                }
              },
              "@media (min-width: 992px)": {
                "&:hover": {
                  ".image-wrapper": {
                    "img": {
                      "transform": "scale(1.1)"
                    }
                  }
                }
              }
            },
            ".col-text": {
              "display": "flex",
              "align-items": "flex-start",
              "width": "~\"calc(50% - 10px)\"",
              "@media (max-width: 1199px)": {
                "width": "100%",
                "order": "1"
              },
              "@media (max-width: 767px)": {
                "width": "100%"
              }
            },
            ".date-wrap": {
              "display": "flex",
              "align-items": "flex-start",
              "gap": "20px",
              "margin-bottom": "10px"
            },
            ".day-text": {
              "color": "#e3ebf3"
            },
            ".month-text": {
              "color": "#e3ebf3"
            },
            ".year-text": {
              "color": "#e3ebf3"
            },
            ".card-title": {
              "color": "#6c7a88"
            },
            ".mbr-text": {
              "margin-top": "12px",
              "color": "#e3ebf3"
            },
            ".mbr-section-btn": {
              "margin-top": "16px",
              "@media (max-width: 767px)": {
                "margin-top": "12px"
              }
            },
            ".col-img": {
              "width": "~\"calc(50% - 10px)\"",
              "@media (max-width: 1199px)": {
                "width": "100%",
                "order": "2"
              },
              "@media (max-width: 767px)": {
                "width": "100%"
              }
            },
            ".image-wrapper": {
              "width": "100%",
              "border-radius": "20px",
              "overflow": "hidden",
              "@media (max-width: 1199px)": {
                "border-radius": "12px"
              },
              "img": {
                "width": "100%",
                "object-fit": "cover",
                "transition": "0.4s all",
                "@media (min-width: 1200px)": {
                  "aspect-ratio": "(299 / 436)"
                },
                "@media (max-width: 1199px)": {
                  "height": "360px"
                },
                "@media (max-width: 767px)": {
                  "height": "220px"
                }
              }
            }
          },
          "_name": "agallery1",
          "_sourceTheme": "homem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"gallery1 homem5\" group=\"Gallery & Slider\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\" plugins=\"mobirise-icons2\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"1\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Day\" name=\"showDay\" checked>\n        <input type=\"checkbox\" title=\"Month\" name=\"showMonth\">\n        <input type=\"checkbox\" title=\"Year\" name=\"showYear\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Border Color\" name=\"borderColor\" value=\"#2E3237\" condition=\"showBorder\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1.jpg\" selected>\n            <input type=\"color\" title=\"Color\" value=\"#1a1e21\">\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#1a1e21\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-start\">\n            \n\n\n\n\n            <div class=\"item features-image active\">\n                <div class=\"item-wrapper\">\n                    <div class=\"col-text\">\n                        <div class=\"card-wrap\">\n                            <div class=\"date-wrap\" mbr-if=\"showDay || showMonth || showYear\">\n                                <p class=\"day-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\" mbr-if=\"showDay\" data-app-selector=\".day-text\">Enhance Your Living Space with Stunning Colors!</p>\n                                <div class=\"date-box\">\n                                    <p class=\"month-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showMonth\" data-app-selector=\".month-text\">\n                                        02\n                                    </p>\n                                    <p class=\"year-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\" mbr-if=\"showYear\" data-app-selector=\".year-text\">\n                                        2023\n                                    </p>\n                                </div>\n                            </div>\n                            <h6 class=\"card-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                                Eget mauris\n                            </h6>\n                            <p class=\"mbr-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">\n                                Transform your home with colors that bring warmth and elegance. Our expert painters ensure a smooth, high-quality finish that elevates your space and matches your style. \n                            </p>\n                            <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"#\" data-app-placeholder=\"Type Text\">Learn More</a></div>\n                        </div>\n                    </div>\n                    <div class=\"col-img\">\n                        <div class=\"image-wrapper\">\n                            <img src=\"@PROJECT_PATH@/assets/images/mbr-686x1029.jpg\" alt data-slide-to=\"1\" data-bs-slide-to=\"1\">\n                        </div>\n                    </div>\n                </div>\n            </div><div class=\"item features-image\">\n                <div class=\"item-wrapper\">\n                    <div class=\"col-text\">\n                        <div class=\"card-wrap\">\n                            <div class=\"date-wrap\" mbr-if=\"showDay || showMonth || showYear\">\n                                <p class=\"day-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\" mbr-if=\"showDay\" data-app-selector=\".day-text\">\n                                    Luxury and Comfort in Every Brushstroke!</p>\n                                <div class=\"date-box\">\n                                    <p class=\"month-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showMonth\" data-app-selector=\".month-text\">\n                                        01\n                                    </p>\n                                    <p class=\"year-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showYear\" data-app-selector=\".year-text\">\n                                        2023\n                                    </p>\n                                </div>\n                            </div>\n                            <h6 class=\"card-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                                Semper quis\n                            </h6>\n                            <p class=\"mbr-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">\n                                 Your bedroom should be a retreat. We use premium paints and techniques to create a serene and stylish ambiance that enhances relaxation and beauty.\n                            </p>\n                            <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"#\" data-app-placeholder=\"Type Text\">Learn More</a></div>\n                        </div>\n                    </div>\n                    <div class=\"col-img\">\n                        <div class=\"image-wrapper\">\n                            <img src=\"@PROJECT_PATH@/assets/images/mbr-686x368.jpeg\" alt data-slide-to=\"0\" data-bs-slide-to=\"0\">\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n\n        </div>\n    </div>\n</section>",
