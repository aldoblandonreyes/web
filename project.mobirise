            },
            ".mbr-section-title": {
              "margin-bottom": "50px",
              "@media (max-width: 767px)": {
                "text-align": "center",
                "margin-bottom": "30px"
              }
            },
            ".mbr-text": {
              "@media (max-width: 767px)": {
                "text-align": "center"
              }
            },
            ".mbr-section-btn": {
              "@media (max-width: 767px)": {
                "text-align": "center"
              }
            }
