                      }
                    },
                    ".card-text": {
                      "margin-bottom": "30px"
                    }
                  }
                }
              }
            },
            ".card-name": {
              "color": "#ffffff"
            },
            ".card-role": {
              "color": "#ffffff"
            },
            ".card-text": {
              "color": "#f2ede4"
            }
          },
          "_cid": "uFLPqGvpId",
          "_anchor": "features03-0",
