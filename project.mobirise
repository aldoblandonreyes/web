                }
              },
              "@media (max-width: 767px)": {
                "gap": "40px",
                "flex-wrap": "wrap",
                "padding": "12px",
                "& when (@showBorder)": {
                  "border-radius": "12px"
                }
              },
              "@media (min-width: 992px)": {
