                "&:nth-child(2)": {
                  "transform": "translateY(-50%) rotate(45deg)"
                },
                "&:nth-child(3)": {
                  "transform": "translateY(-50%) rotate(-45deg)"
                },
                "&:nth-child(4)": {
                  "display": "none"
                }
              }
            },
            ".navbar-dropdown": {
              "padding": "0 1rem",
