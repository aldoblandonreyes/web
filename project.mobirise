                    "margin-bottom": "~\"calc(6vh * 0.38)\" !important",
                    "border-radius": "0",
                    "font-size": "6vh !important",
                    "line-height": "1 !important",
                    "justify-content": "flex-start"
                  }
                }
              }
            },
            "@media (max-width: 575px)": {
              ".container-fluid": {
                "padding": "5px 12px !important",
                "column-gap": "6px"
              },
              ".navbar-collapse": {
                "padding": "50px 20px"
              },
              ".navbar-nav": {
                ".nav-item": {
