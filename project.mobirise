                "gap": "40px"
              },
              "@media (max-width: 992px)": {
                "display": "block"
              },
              ".item": {
                "margin-bottom": "40px",
                ".item-wrapper": {
                  "display": "flex",
                  "@media (max-width: 992px)": {
                    "display": "block"
                  },
                  ".item-img": {
                    "@media (max-width: 992px)": {
                      "margin-bottom": "25px"
                    },
                    "img": {
                      "width": "90px",
                      "height": "90px",
                      "object-fit": "cover",
                      "border-radius": "100% !important"
                    }
                  },
                  ".item-content": {
                    "margin-left": "25px",
                    "@media (max-width: 992px)": {
                      "margin-left": "0",
                      "margin-bottom": "25px"
                    },
                    ".name-wrapper": {
                      "margin-bottom": "40px",
                      ".card-name": {
                        "margin-bottom": "0"
                      },
                      ".card-role": {
                        "opacity": ".4",
